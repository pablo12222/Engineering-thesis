<devicesets>
<deviceset name="WCAP-ATG5_5X11" urn="urn:adsk.eagle:component:18308033/4" prefix="C" library_version="5">
<description>&lt;b&gt;WCAP-ATG5 Aluminium Electrolytic Capacitors &lt;/B&gt;&lt;BR&gt;&lt;BR&gt;

&lt;B&gt;General Purpose +105 °C &lt;/B&gt;&lt;BR&gt;&lt;BR&gt;
&lt;B&gt;Characteristics&lt;/B&gt;&lt;BR&gt;
&lt;BR&gt;General purpose product series with max. operating temperature of +105 °C 
&lt;BR&gt;Mounting style: THT Radial 
&lt;BR&gt;Capacitance range: 0.1 µF ‒ 18000 µF 
&lt;BR&gt;Capacitance tolerance: ±20 % 
&lt;BR&gt;Operating temperature: 
&lt;BR&gt;-40 °C up to +105 °C for UR &lt; 400 V(DC) 
&lt;BR&gt;-25 °C up to +105 °C for UR ≥ 400 V(DC) 
&lt;BR&gt;Endurance: 2000 h @ +105 °C 
&lt;BR&gt;Dimensions (DxL) in mm: 5.0 x 11.0 up to 22.0 x 31.0 
&lt;BR&gt;Recommended soldering: Wave soldering 
&lt;BR&gt;
&lt;BR&gt;
&lt;B&gt;Applications&lt;/B&gt;&lt;BR&gt;
&lt;BR&gt;Filtering 
&lt;BR&gt;Smoothing 
&lt;BR&gt;Energy storage 
&lt;BR&gt;Coupling 
e.g. Switched-mode power supply, AC/DC converter, adapter, charger, digital camera 
&lt;BR&gt;
&lt;BR&gt;&lt;BR&gt;
&lt;BR&gt;
&lt;br&gt;&lt;a href="https://www.we-online.com/catalog/media/o683503v209%20family-wcap-atg5-860020672004.jpg" title="Enlarge picture"&gt;
&lt;img src="https://www.we-online.com/catalog/media/o683503v209%20family-wcap-atg5-860020672004.jpg"  width="320"&gt;&lt;/a&gt;&lt;p&gt;

&lt;/b&gt;&lt;br&gt;            
Details see: &lt;a href="www.we-online.com/catalog/WCAP-ATG5/?utm_source=eagle_model&amp;utm_medium=description_link&amp;utm_campaign=eisos_eagle"&gt;www.we-online.com/catalog/WCAP-ATG5&lt;/a&gt;&lt;p&gt;
Updated by yingchun,Shan;2020-02-28
&lt;br&gt;2020(C) Würth Elektronik</description>
<gates>
<gate name="G$1" symbol="C_POLAR" x="0" y="0"/>
</gates>
